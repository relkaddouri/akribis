# Copiez ce fichier en `.env` puis remplissez les valeurs :
#   cp .env.example .env
#
# Pourquoi `.env` et pas `.env.local` : les scripts Node (prisma.config.ts,
# prisma/*.ts, scripts/promote-admin.ts) utilisent `import "dotenv/config"`,
# qui ne lit que `.env`. Next.js lit `.env` aussi — un seul fichier suffit
# donc pour l'app et pour les scripts.
#
# `.env` est ignoré par git (`.env*` dans .gitignore) : ne commitez jamais
# vos vraies clés.

# ---------------------------------------------------------------------------
# Correspondance avec les noms affiches par Supabase
# ---------------------------------------------------------------------------
# Le dashboard Supabase propose des noms generiques. Ce projet en utilise
# d'autres : ce sont ceux que le code lit reellement. Meme valeur, autre nom.
#
#   Supabase affiche            ->  A mettre dans ce fichier
#   --------------------------------------------------------------------
#   SUPABASE_URL                ->  NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY    ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SECRET_KEY         ->  SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_JWKS_URL           ->  (non utilise par ce projet)
#
# Le prefixe NEXT_PUBLIC_ n'est pas cosmetique : il autorise Next.js a
# injecter la variable dans le bundle navigateur. Sans lui, le client
# Supabase cote navigateur recoit `undefined`. Ne l'ajoutez JAMAIS devant
# une cle secrete : elle se retrouverait publiee dans le JavaScript envoye
# a chaque visiteur.
#
# "SECRET_KEY" (nouveau nommage Supabase, format sb_secret_...) et
# "SERVICE_ROLE_KEY" (ancien nommage, format JWT eyJ...) designent la meme
# chose : la cle qui contourne toutes les regles RLS.

# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Supabase)
# ---------------------------------------------------------------------------
# Supabase Dashboard > Project Settings > Database > Connection string > URI.
# Utilisez le pooler (port 6543) avec `?pgbouncer=true` pour l'app, ou la
# connexion directe (port 5432) pour les migrations Prisma.
# Utilisé par : lib/db/client.ts, prisma.config.ts, prisma/*.ts
DATABASE_URL="postgresql://postgres.VOTRE_PROJET:MOT_DE_PASSE@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Supabase Dashboard > Project Settings > API

# URL du projet, exposée au navigateur.
# Utilisé par : lib/supabase/{server,middleware,admin}.ts, scripts/promote-admin.ts
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJET.supabase.co"

# Clé publique (anon / publishable), exposée au navigateur.
# Utilisé par : lib/supabase/{server,middleware}.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Clé service_role — SECRÈTE, côté serveur uniquement, jamais dans le client.
# Elle contourne toutes les règles RLS.
# Utilisé par : lib/supabase/admin.ts, scripts/promote-admin.ts
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Alias accepté par scripts/promote-admin.ts si SUPABASE_SERVICE_ROLE_KEY
# est absent. Laissez vide si vous avez déjà rempli la ligne ci-dessus.
SUPABASE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Origine publique de l'app, requise par `npm run admin:promote -- <email> --invite`
# pour construire le lien de redirection de l'e-mail d'invitation.
# Utilisé par : scripts/promote-admin.ts
APP_ORIGIN="http://localhost:3000"