// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

model Pharmacy {
  id              String   @id @default(uuid())
  name            String
  address         String?
  phone           String?
  /// ICE (Identifiant Commun de l'Entreprise) — Moroccan business registry number.
  ice             String?
  orderNumber     String?  @map("order_number")
  /// INPE — Identifiant National du Praticien et de l'Établissement.
  /// Identifie l'officine auprès des organismes de tiers payant ; il figure
  /// sur les bordereaux qu'on leur adresse.
  inpe            String?
  logoUrl         String?  @map("logo_url")
  /// Free-form receipt customization: { showLogo, legalNotice, thankYouMessage }.
  receiptSettings Json?    @map("receipt_settings")
  /// Dirhams that earn one loyalty point. 1 means "1 DH = 1 point";
  /// raising it makes points scarcer. Never 0 — see lib/clients/account.ts.
  loyaltyRate     Decimal  @default(1) @map("loyalty_rate") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users              User[]
  products           Product[]
  stockMovements     StockMovement[]
  clients            Client[]
  sales              Sale[]
  saleItems          SaleItem[]
  suppliers          Supplier[]
  orders             Order[]
  orderItems         OrderItem[]
  invoices           Invoice[]
  saleReturns        SaleReturn[]
  clientTransactions ClientTransaction[]
  clientReminders    ClientReminder[]
  deliveries         Delivery[]
  supplierCredits    SupplierCredit[]

  inventorySessions InventorySession[]

  pharmacyStock PharmacyStock[]
  organismes    OrganismeTiersPayant[]

  @@map("pharmacies")
}

enum UserRole {
  OWNER     @map("owner")
  ASSISTANT @map("assistant")

  @@map("user_role")
}

/// Profile row for a Supabase Auth user. `id` mirrors the `auth.users.id`
/// UUID of the matching Supabase account; credentials live in Supabase
/// Auth, not here.
model User {
  id         String   @id @default(uuid())
  pharmacyId String   @map("pharmacy_id")
  name       String
  email      String   @unique
  role       UserRole @default(ASSISTANT)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy            Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  sales               Sale[]
  saleReturns         SaleReturn[]
  publicationLectures PublicationLecture[]
  inventorySessions   InventorySession[]

  @@index([pharmacyId])
  @@map("users")
}

model Product {
  id                 String    @id @default(uuid())
  pharmacyId         String    @map("pharmacy_id")
  name               String
  form               String
  dosage             String?
  laboratory         String?
  barcode            String?
  dci                String?
  photoUrl           String?   @map("photo_url")
  /// One of the fixed values in PRODUCT_CATEGORIES (lib/validations/products.ts).
  category           String?
  /// Selling price used at the point of sale.
  price              Decimal   @default(0) @db.Decimal(10, 2)
  /// Purchase/cost price — used to compute gross margin (price - purchasePrice) on sales reporting.
  purchasePrice      Decimal?  @map("purchase_price") @db.Decimal(10, 2)
  /// Prix Public Hospitalier — regulated reference price, separate from `price`.
  pph                Decimal?  @db.Decimal(10, 2)
  tvaVente           Decimal?  @map("tva_vente") @db.Decimal(5, 2)
  tvaAchat           Decimal?  @map("tva_achat") @db.Decimal(5, 2)
  lowStockThreshold  Int       @default(0) @map("low_stock_threshold")
  quantityInStock    Int       @default(0) @map("quantity_in_stock")
  nearestExpiryDate  DateTime? @map("nearest_expiry_date")
  remboursable       Boolean   @default(false)
  /// Only meaningful when `remboursable` is true.
  baseRemboursement  Decimal?  @map("base_remboursement") @db.Decimal(10, 2)
  posologieEnfant    String?   @map("posologie_enfant")
  posologieAdulte    String?   @map("posologie_adulte")
  monographie        String?
  /// La fiche catalogue nationale dont ce produit est issu, quand il a été
  /// ajouté depuis le catalogue. Nul pour les produits saisis à la main
  /// avant — ou après — cette bascule : le champ relie, il n'impose pas.
  ///
  /// `products` reste la table opérationnelle (quantité, prix pratiqué,
  /// ventes, réceptions, inventaire). Ce lien est ce qui permet à la fiche
  /// produit d'afficher les informations catalogue en lecture seule, et il
  /// prépare la bascule complète des lectures — voir docs/migration-catalogue.md.
  catalogueProduitId String?   @map("catalogue_produit_id")
  /// Désactivé par l'officine, pour elle seule : le produit disparaît du
  /// comptoir et des commandes fournisseur, mais reste au stock avec ses
  /// lots, ses mouvements et ses ventes passées. Toujours réversible.
  ///
  /// Distinct de `CatalogueProduit.actifCatalogue`, qui est national et
  /// n'appartient qu'à l'Admin. Porté ici plutôt que sur `pharmacy_stock`
  /// parce que c'est `products` que lisent toutes les lectures
  /// opérationnelles — et parce qu'un produit saisi à la main n'a pas de
  /// ligne `pharmacy_stock` : le drapeau y serait resté hors d'atteinte
  /// pour la moitié du stock.
  actifLocalement    Boolean   @default(true) @map("actif_localement")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  pharmacy        Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  /// `SetNull` plutôt que `Cascade` : retirer une fiche du catalogue ne doit
  /// jamais faire disparaître le stock d'une officine ni ses ventes passées.
  catalogue       CatalogueProduit?    @relation(fields: [catalogueProduitId], references: [id], onDelete: SetNull)
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  orderItems      OrderItem[]
  returnLines     SaleReturnLine[]
  reminders       ClientReminder[]
  deliveryItems   DeliveryItem[]
  creditItems     SupplierCreditItem[]
  inventoryCounts InventoryCount[]

  @@unique([pharmacyId, barcode])
  @@index([pharmacyId])
  @@index([catalogueProduitId])
  @@map("products")
}

enum StockMovementType {
  IN
  OUT

  @@map("stock_movement_type")
}

model StockMovement {
  id         String            @id @default(uuid())
  pharmacyId String            @map("pharmacy_id")
  productId  String            @map("product_id")
  type       StockMovementType
  quantity   Int
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([pharmacyId])
  @@index([productId])
  @@map("stock_movements")
}

model Client {
  id             String  @id @default(uuid())
  pharmacyId     String  @map("pharmacy_id")
  name           String
  phone          String?
  /// Running account balance. NEGATIVE means the client owes the pharmacy
  /// (credit sale), POSITIVE means the pharmacy owes the client.
  ///
  /// Denormalised from ClientTransaction and kept in step with it inside
  /// one database transaction — see recordClientTransaction() in
  /// lib/server/client-account.ts, the single writer. It must always equal
  /// the sum of the client's transaction amounts.
  solde          Decimal @default(0) @db.Decimal(12, 2)
  pointsFidelite Int     @default(0) @map("points_fidelite")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pharmacy     Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  sales        Sale[]
  transactions ClientTransaction[]
  reminders    ClientReminder[]

  @@index([pharmacyId])
  @@map("clients")
}

enum ClientTransactionType {
  VENTE            @map("vente")
  PAIEMENT_PARTIEL @map("paiement_partiel")
  AVOIR_RECU       @map("avoir_recu")
  AJUSTEMENT       @map("ajustement")

  @@map("client_transaction_type")
}

/// Every movement of a client's balance, in order. The amount is SIGNED
/// and uses the same convention as Client.solde: negative increases the
/// debt (a credit sale), positive reduces it (a payment). Summing this
/// table must reproduce Client.solde exactly.
model ClientTransaction {
  id          String                @id @default(uuid())
  pharmacyId  String                @map("pharmacy_id")
  clientId    String                @map("client_id")
  type        ClientTransactionType
  montant     Decimal               @db.Decimal(12, 2)
  date        DateTime              @default(now())
  /// The sale this movement came from, when it came from one.
  saleId      String?               @map("sale_id")
  description String?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([clientId, date])
  @@index([pharmacyId])
  @@index([saleId])
  @@map("client_transactions")
}

enum ReminderStatus {
  A_FAIRE @map("a_faire")
  FAIT    @map("fait")
  ANNULE  @map("annule")

  @@map("reminder_status")
}

/// A manual call-back note. Deliberately no automated messaging in this
/// version: the pharmacist phones the client themselves.
model ClientReminder {
  id         String         @id @default(uuid())
  pharmacyId String         @map("pharmacy_id")
  clientId   String         @map("client_id")
  productId  String?        @map("product_id")
  dateRappel DateTime       @map("date_rappel")
  note       String
  statut     ReminderStatus @default(A_FAIRE)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, dateRappel])
  @@index([clientId])
  @@map("client_reminders")
}

enum PaymentMethod {
  CASH   @map("cash")
  CARD   @map("card")
  /// Sale taken on account — settled later, and only allowed when a
  /// client is attached, since an anonymous walk-in has nobody to bill.
  CREDIT @map("credit")

  @@map("payment_method")
}

model Sale {
  id            String        @id @default(uuid())
  pharmacyId    String        @map("pharmacy_id")
  clientId      String?       @map("client_id")
  userId        String?       @map("user_id")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at")

  /// Set once the sale has been billed. A sale belongs to at most one
  /// invoice, which is what stops the same sale being invoiced twice.
  invoiceId String? @map("invoice_id")

  /// Denormalised from the sale's lines, written in the same transaction
  /// as every return — mirrors how Order.status works. Stored rather than
  /// derived so the sales list can filter on it without aggregating every
  /// line of every sale.
  returnStatus SaleReturnStatus @default(NONE) @map("return_status")

  pharmacy           Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  returns            SaleReturn[]
  clientTransactions ClientTransaction[]

  @@index([pharmacyId])
  @@index([clientId])
  @@index([userId])
  @@index([invoiceId])
  @@map("sales")
}

model SaleItem {
  id               String  @id @default(uuid())
  pharmacyId       String  @map("pharmacy_id")
  saleId           String  @map("sale_id")
  productId        String  @map("product_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  /// Cumulative quantity returned so far across one or more returns —
  /// the cap that stops a line being refunded more than it was sold.
  returnedQuantity Int     @default(0) @map("returned_quantity")

  pharmacy    Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnLines SaleReturnLine[]

  @@index([pharmacyId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Supplier {
  id         String   @id @default(uuid())
  pharmacyId String   @map("pharmacy_id")
  name       String
  phone      String?
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orders   Order[]
  credits  SupplierCredit[]

  pharmacyStock PharmacyStock[]

  @@index([pharmacyId])
  @@map("suppliers")
}

enum OrderStatus {
  BROUILLON           @map("brouillon")
  ENVOYEE             @map("envoyee")
  PARTIELLEMENT_RECUE @map("partiellement_recue")
  RECUE               @map("recue")
  CLOTUREE            @map("cloturee")

  @@map("order_status")
}

model Order {
  id         String      @id @default(uuid())
  pharmacyId String      @map("pharmacy_id")
  supplierId String      @map("supplier_id")
  status     OrderStatus @default(BROUILLON)
  /// Sequential per pharmacy, allocated atomically — see lib/server/sequences.ts.
  numero     Int
  createdAt  DateTime    @default(now()) @map("date_creation")
  /// Set when the order actually leaves for the supplier; null while draft.
  dateEnvoi  DateTime?   @map("date_envoi")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  pharmacy   Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  items      OrderItem[]
  deliveries Delivery[]
  credits    SupplierCredit[]

  @@unique([pharmacyId, numero])
  @@index([pharmacyId])
  @@index([supplierId])
  @@map("orders")
}

/// One physical delivery against an order. An order may receive several,
/// which is what makes partial receipts first-class rather than a running
/// total smeared over OrderItem.
model Delivery {
  id            String   @id @default(uuid())
  pharmacyId    String   @map("pharmacy_id")
  orderId       String   @map("order_id")
  /// Sequential per pharmacy and independent of the order numbering.
  numero        Int
  dateReception DateTime @default(now()) @map("date_reception")
  createdAt     DateTime @default(now()) @map("created_at")

  pharmacy Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items    DeliveryItem[]

  @@unique([pharmacyId, numero])
  @@index([orderId])
  @@index([pharmacyId, dateReception])
  @@map("deliveries")
}

/// What actually arrived in one delivery — deliberately independent of
/// OrderItem.quantity, since a supplier may short-ship or over-ship.
model DeliveryItem {
  id            String @id @default(uuid())
  deliveryId    String @map("delivery_id")
  orderItemId   String @map("order_item_id")
  productId     String @map("product_id")
  quantiteRecue Int    @map("quantite_recue")

  delivery  Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([orderItemId])
  @@index([productId])
  @@map("delivery_items")
}

enum SupplierCreditStatus {
  EMIS @map("emis")
  RECU @map("recu")

  @@map("supplier_credit_status")
}

enum SupplierCreditMotif {
  PRODUIT_ENDOMMAGE @map("produit_endommage")
  PRODUIT_PERIME    @map("produit_perime")
  RAPPEL_LOT        @map("rappel_lot")
  ERREUR_LIVRAISON  @map("erreur_livraison")
  ERREUR_PRIX       @map("erreur_prix")
  REMISE            @map("remise")
  AUTRE             @map("autre")

  @@map("supplier_credit_motif")
}

enum SupplierCreditCompensation {
  AVOIR_CREDIT @map("avoir_credit")
  ESPECES      @map("especes")

  @@map("supplier_credit_compensation")
}

/// A supplier credit note. ONE document that moves through its own
/// lifecycle (emis → recu) rather than two tables for the two ends of it:
/// the same piece of paper is what the pharmacy issues and what the
/// supplier later honours.
///
/// STOCK RULE: the goods leave stock when the credit is ISSUED (`emis`),
/// never when it is settled (`recu`). Settlement only records how the
/// supplier compensated — decrementing again there would double-count.
/// Enforced in lib/server/supplier-credits.ts.
model SupplierCredit {
  id               String                      @id @default(uuid())
  pharmacyId       String                      @map("pharmacy_id")
  supplierId       String                      @map("supplier_id")
  /// The order the claim relates to, when it relates to one.
  orderId          String?                     @map("order_id")
  /// Sequential per pharmacy, independent of orders and deliveries.
  numero           Int
  statut           SupplierCreditStatus        @default(EMIS)
  motif            SupplierCreditMotif
  /// Only meaningful once `statut` is RECU — how the supplier settled.
  modeCompensation SupplierCreditCompensation? @map("mode_compensation")
  montant          Decimal                     @db.Decimal(12, 2)
  /// How much of `montant` is still available to offset a future order.
  /// Starts equal to `montant` and only ever decreases, as orders consume
  /// it — this is what stops the same credit being applied twice.
  montantRestant   Decimal                     @default(0) @map("montant_restant") @db.Decimal(12, 2)
  dateEmission     DateTime                    @default(now()) @map("date_emission")
  /// Null until the supplier confirms.
  dateReception    DateTime?                   @map("date_reception")
  /// Regulatory traceability: this credit stems from an official lot recall.
  lieRappelLot     Boolean                     @default(false) @map("lie_rappel_lot")
  note             String?
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  pharmacy Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  order    Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items    SupplierCreditItem[]

  @@unique([pharmacyId, numero])
  @@index([pharmacyId, dateEmission])
  @@index([supplierId])
  @@index([orderId])
  @@map("supplier_credits")
}

model SupplierCreditItem {
  id        String  @id @default(uuid())
  creditId  String  @map("credit_id")
  productId String  @map("product_id")
  quantite  Int
  /// Unit value claimed, snapshotted at issue time.
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  credit  SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@index([creditId])
  @@index([productId])
  @@map("supplier_credit_items")
}

/// Generic per-(pharmacy, scope) sequence for document numbering.
///
/// Incremented with one atomic INSERT ... ON CONFLICT DO UPDATE — the same
/// guarantee InvoiceCounter gives invoices, which keeps its own table so
/// its established year-based numbering is never disturbed.
///
/// Unlike invoices these sequences never reset: an order numbered 412 stays
/// 412 forever, which is what makes `@@unique([pharmacyId, numero])` on each
/// document table a meaningful constraint.
model DocumentCounter {
  pharmacyId   String @map("pharmacy_id")
  /// "order" | "delivery" | "supplier_credit"
  scope        String
  lastSequence Int    @default(0) @map("last_sequence")

  @@id([pharmacyId, scope])
  @@map("document_counters")
}

model OrderItem {
  id               String  @id @default(uuid())
  pharmacyId       String  @map("pharmacy_id")
  orderId          String  @map("order_id")
  productId        String  @map("product_id")
  quantity         Int
  /// Cumulative quantity received so far across one or more receptions.
  receivedQuantity Int     @default(0) @map("received_quantity")
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)

  pharmacy      Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  deliveryItems DeliveryItem[]

  @@index([pharmacyId])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Editorial feed published by the Akribis team itself — deliberately NOT
/// scoped to a pharmacy: every pharmacy sees the same publications. Only
/// the read-state (PublicationLecture) is per user.
enum PublicationType {
  NOUVEAUTE     @map("nouveaute")
  ALERTE        @map("alerte")
  MAINTENANCE   @map("maintenance")
  ANNONCE_SUITE @map("annonce_suite")

  @@map("publication_type")
}

enum NiveauUrgence {
  FAIBLE  @map("faible")
  MOYENNE @map("moyenne")
  ELEVEE  @map("elevee")

  @@map("niveau_urgence")
}

enum OutilAkribis {
  INTELLIGENCE @map("intelligence")
  LABO         @map("labo")
  MEDICAL      @map("medical")
  SUITE        @map("suite")

  @@map("outil_akribis")
}

model Publication {
  id              String          @id @default(uuid())
  titre           String
  contenu         String
  type            PublicationType
  /// Only meaningful when `type` is ALERTE — drives the badge colour.
  niveauUrgence   NiveauUrgence?  @map("niveau_urgence")
  /// Only meaningful when `type` is ANNONCE_SUITE — which companion product the announcement is about.
  outilAssocie    OutilAkribis?   @map("outil_associe")
  imageUrl        String?         @map("image_url")
  datePublication DateTime        @default(now()) @map("date_publication")
  auteur          String          @default("Équipe Akribis")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  lectures PublicationLecture[]

  @@index([datePublication])
  @@map("publications")
}

/// One row per (user, publication) once the user has seen it. Absence of a
/// row is what makes a publication "unread" — no boolean to keep in sync.
model PublicationLecture {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  publicationId String   @map("publication_id")
  luLe          DateTime @default(now()) @map("lu_le")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, publicationId])
  @@index([userId])
  @@index([publicationId])
  @@map("publication_lectures")
}

enum InvoiceStatus {
  ISSUED    @map("issued")
  CANCELLED @map("cancelled")

  @@map("invoice_status")
}

/// Per-pharmacy, per-year invoice sequence. Incremented with a single
/// atomic `INSERT ... ON CONFLICT DO UPDATE ... RETURNING`, which takes a
/// row lock and therefore serialises concurrent invoice creations —
/// reading a MAX() and writing back in application code would race and
/// hand two invoices the same number.
model InvoiceCounter {
  pharmacyId   String @map("pharmacy_id")
  year         Int
  lastSequence Int    @default(0) @map("last_sequence")

  @@id([pharmacyId, year])
  @@map("invoice_counters")
}

/// A legal document: every field a printed invoice shows is snapshotted
/// here at issue time rather than joined at render time. Editing the
/// pharmacy's address, renaming a client or deleting a product must never
/// retroactively change an invoice that has already been handed out.
model Invoice {
  id         String        @id @default(uuid())
  pharmacyId String        @map("pharmacy_id")
  /// Display number, e.g. "FACT-2026-0001".
  number     String
  year       Int
  sequence   Int
  status     InvoiceStatus @default(ISSUED)
  issuedAt   DateTime      @default(now()) @map("issued_at")

  pharmacyName    String  @map("pharmacy_name")
  pharmacyAddress String? @map("pharmacy_address")
  pharmacyPhone   String? @map("pharmacy_phone")
  pharmacyIce     String? @map("pharmacy_ice")

  /// Kept as a plain snapshot alongside the id: the same invoice format
  /// serves individuals, insurers and companies, so no client type here.
  clientId   String? @map("client_id")
  clientName String? @map("client_name")

  totalHt  Decimal @map("total_ht") @db.Decimal(12, 2)
  totalTva Decimal @map("total_tva") @db.Decimal(12, 2)
  totalTtc Decimal @map("total_ttc") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  lines    InvoiceLine[]
  /// The sales this invoice bills — one invoice may group several.
  sales    Sale[]

  @@unique([pharmacyId, number])
  @@unique([pharmacyId, year, sequence])
  @@index([pharmacyId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  /// Nullable on purpose: the product may be deleted later; `designation`
  /// is the snapshot that keeps the invoice readable regardless.
  productId   String? @map("product_id")
  designation String
  quantity    Int
  unitPriceHt Decimal @map("unit_price_ht") @db.Decimal(10, 2)
  /// VAT percentage applied to this line, snapshotted from the product.
  tvaRate     Decimal @map("tva_rate") @db.Decimal(5, 2)
  totalHt     Decimal @map("total_ht") @db.Decimal(12, 2)
  totalTva    Decimal @map("total_tva") @db.Decimal(12, 2)
  totalTtc    Decimal @map("total_ttc") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

enum SaleReturnStatus {
  NONE    @map("none")
  PARTIAL @map("partial")
  FULL    @map("full")

  @@map("sale_return_status")
}

/// One recorded return against a sale. Several partial returns may stack
/// on the same sale; the cumulative quantities are capped by what was
/// actually sold (see SaleItem.returnedQuantity).
model SaleReturn {
  id         String   @id @default(uuid())
  pharmacyId String   @map("pharmacy_id")
  saleId     String   @map("sale_id")
  /// Who processed the return — kept for traceability, nullable so
  /// deleting a user never erases the return itself.
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  /// Flags a return triggered by an official lot recall, which carries
  /// regulatory reporting obligations that an ordinary client return
  /// doesn't.
  isLotRecall     Boolean @default(false) @map("is_lot_recall")
  /// Reference of the recall notice (ministry circular, batch number…),
  /// so a recalled batch can be traced back later.
  recallReference String? @map("recall_reference")
  note            String?

  totalRefund Decimal @map("total_refund") @db.Decimal(12, 2)

  pharmacy Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  sale     Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines    SaleReturnLine[]

  @@index([pharmacyId, createdAt])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnLine {
  id           String  @id @default(uuid())
  returnId     String  @map("return_id")
  saleItemId   String  @map("sale_item_id")
  productId    String  @map("product_id")
  quantity     Int
  /// Snapshot of the price refunded per unit.
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  refundAmount Decimal @map("refund_amount") @db.Decimal(12, 2)
  /// Decided per line, per return: false means the goods were destroyed
  /// rather than put back on the shelf (recalled or unsellable batches),
  /// so no stock is credited but the movement stays on record.
  restocked    Boolean @default(true)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
  @@index([productId])
  @@map("sale_return_lines")
}

enum InventorySessionStatus {
  EN_COURS @map("en_cours")
  TERMINE  @map("termine")

  @@map("inventory_session_status")
}

/// A stock count in progress or finished. The id is generated by the
/// client when the session is queued offline, which is what makes a
/// replayed sync a no-op rather than a second session.
model InventorySession {
  id         String                 @id @default(uuid())
  pharmacyId String                 @map("pharmacy_id")
  userId     String?                @map("user_id")
  statut     InventorySessionStatus @default(EN_COURS)
  dateDebut  DateTime               @default(now()) @map("date_debut")
  /// Null until the adjustments are applied.
  dateFin    DateTime?              @map("date_fin")
  createdAt  DateTime               @default(now()) @map("created_at")

  pharmacy Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  counts   InventoryCount[]

  @@index([pharmacyId, dateDebut])
  @@map("inventory_sessions")
}

model InventoryCount {
  id                String    @id @default(uuid())
  sessionId         String    @map("session_id")
  productId         String    @map("product_id")
  /// Stock as it stood when the product was added to the session. Frozen
  /// on purpose: recomputing it at sync time would silently erase the very
  /// discrepancy the count exists to reveal.
  quantiteTheorique Int       @map("quantite_theorique")
  /// Null until someone actually counts the shelf.
  quantiteComptee   Int?      @map("quantite_comptee")
  dateComptage      DateTime? @map("date_comptage")

  session InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id])

  /// One line per product per session — this is also what makes a replayed
  /// count an update rather than a duplicate row.
  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
  @@map("inventory_counts")
}

// ---------------------------------------------------------------------------
// Catalogue Produits — PRD "Akribis — Catalogue Produits" v1.0, section 5.
//
// Le produit est scindé en trois niveaux, conformément à la section 4 : ce qui
// est vrai partout au Maroc (CatalogueProduit), ce qui appartient à une
// officine (PharmacyStock), et ce qui appartient à une réception précise
// (ProductLot).
//
// Ces tables vivent EN PARALLÈLE de `products`, qui reste la source de vérité
// du code applicatif à ce stade. Voir docs/migration-catalogue.md.
// ---------------------------------------------------------------------------

/// Section 5.1 — « Catégorie ». À ne pas confondre avec la classe
/// thérapeutique : celle-ci dit à quoi le produit sert, celle-là ce qu'il est
/// juridiquement — et détermine le taux de TVA (7 % médicament, 20 % para).
enum ProduitCategorie {
  PHARMACEUTIQUE     @map("pharmaceutique")
  PARAPHARMACEUTIQUE @map("parapharmaceutique")
  DISPOSITIF_MEDICAL @map("dispositif_medical")

  @@map("produit_categorie")
}

/// Section 3.2 — tableaux des substances vénéneuses (classification légale
/// marocaine). `AUCUN` couvre la délivrance libre.
enum TableauSubstance {
  AUCUN @map("aucun")
  A     @map("a")
  B     @map("b")
  C     @map("c")

  @@map("tableau_substance")
}

/// Niveau national, maintenu par Akribis. Volontairement SANS `pharmacyId` :
/// une seule ligne par produit, partagée par toutes les officines — c'est tout
/// l'objet du PRD.
model CatalogueProduit {
  id String @id @default(uuid())

  // --- Identification et classification (5.1) ---
  nom                   String
  /// CBO/CIP 13 chiffres (médicament) ou EAN-13/UPC (parapharmacie). Unique au
  /// niveau national : c'est l'identifiant qui empêche deux fiches pour le
  /// même produit. Nul tant qu'un produit n'en a pas — la parapharmacie
  /// n'a pas de code national.
  codeBarres            String?           @unique @map("code_barres")
  /// Absent de la liste 5.1, où le dosage fait partie du « Nom ». Conservé
  /// parce que `products.dosage` existe déjà et que le référentiel CNOPS le
  /// fournit séparément (DOSAGE1/UNITE_DOSAGE1) — le fusionner dans le nom
  /// perdrait de l'information à la migration.
  dosage                String?
  /// Nul pour les produits migrés depuis `products`, où l'information
  /// n'existait pas : « à classer » plutôt qu'une valeur inventée dont
  /// dépendrait le taux de TVA.
  categorie             ProduitCategorie?
  classeTherapeutique   String?           @map("classe_therapeutique")
  formeGalenique        String            @map("forme_galenique")
  dci                   String?
  laboratoire           String?
  produitTableau        TableauSubstance  @default(AUCUN) @map("produit_tableau")
  gamme                 String?
  sousGamme             String?           @map("sous_gamme")
  necessitePrescription Boolean           @default(false) @map("necessite_prescription")
  /// Statut réglementaire national : le produit est-il encore autorisé à la
  /// vente au Maroc. Distinct de `actifLocalement` côté officine.
  produitCommercialise  Boolean           @default(true) @map("produit_commercialise")
  groupeProduits        String?           @map("groupe_produits")
  /// Marque commerciale. Distincte de `laboratoire` : en parapharmacie
  /// c'est la marque qui identifie le produit au rayon, pas le fabricant.
  marque                String?
  /// Hiérarchie de RAYON, pour naviguer et filtrer le catalogue.
  /// À ne pas confondre avec `gamme`/`sousGamme`, qui restent la ligne de
  /// produit du laboratoire — deux découpages différents du même produit.
  categoriePrincipale   String?           @map("categorie_principale")
  sousCategorie         String?           @map("sous_categorie")
  sousSousCategorie     String?           @map("sous_sous_categorie")
  /// Mots-clés libres, pour la recherche.
  etiquettes            String?
  /// Retrait du catalogue sans suppression — la traçabilité impose de garder
  /// la ligne, référencée par des ventes passées.
  actifCatalogue        Boolean           @default(true) @map("actif_catalogue")
  refrigerationRequise  Boolean           @default(false) @map("refrigeration_requise")

  // --- Prix et fiscalité (5.1), non modifiables par la pharmacie ---
  pph                   Decimal? @db.Decimal(10, 2)
  ppv                   Decimal? @db.Decimal(10, 2)
  /// PRIX_BR du référentiel CNOPS — un montant, pas un taux.
  prixBaseRemboursement Decimal? @map("prix_base_remboursement") @db.Decimal(10, 2)
  tvaAchat              Decimal? @map("tva_achat") @db.Decimal(5, 2)
  tvaVente              Decimal? @map("tva_vente") @db.Decimal(5, 2)
  remboursable          Boolean  @default(false)
  /// « Base de remboursement (%) » — un taux (70 ou 0 dans le CNOPS 2014),
  /// à ne pas confondre avec `prixBaseRemboursement` ci-dessus.
  tauxRemboursement     Decimal? @map("taux_remboursement") @db.Decimal(5, 2)
  /// Prix de référence NON réglementé, pour la parapharmacie.
  ///
  /// À ne jamais confondre avec `ppv`, qui est le prix public réglementé
  /// d'un médicament : ici le prix reste libre pour chaque officine une
  /// fois la fiche recopiée dans son stock. Ce champ n'est qu'un point de
  /// départ indicatif — c'est pourquoi il porte son propre nom plutôt que
  /// de réutiliser `ppv`, qui aurait fait passer un prix libre pour un
  /// prix encadré.
  prixVenteIndicatif    Decimal? @map("prix_vente_indicatif") @db.Decimal(10, 2)

  // --- Informations descriptives (5.1) ---
  description                 String?
  excipients                  String?
  posologieAdulte             String? @map("posologie_adulte")
  posologieEnfant             String? @map("posologie_enfant")
  indications                 String?
  /// Trois champs distincts, comme le demande le PRD : une contre-indication
  /// à la conduite ne se déduit pas d'une contre-indication à la grossesse.
  contreIndicationConduite    String? @map("contre_indication_conduite")
  contreIndicationAllaitement String? @map("contre_indication_allaitement")
  contreIndicationGrossesse   String? @map("contre_indication_grossesse")
  referenceLabo               String? @map("reference_labo")
  conditionnement             String?
  monographie                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stocks   PharmacyStock[]
  photos   CatalogueProduitPhoto[]
  produits Product[]

  @@index([nom])
  @@index([dci])
  @@index([laboratoire])
  @@map("catalogue_produits")
}

/// Photos d'une fiche catalogue, ordonnées. Une table plutôt qu'un tableau
/// de textes : `ordre` porte la notion de photo principale (la plus basse),
/// et une ligne par photo permet d'en supprimer une sans réécrire les
/// autres — un tableau se remplace en entier à chaque modification.
model CatalogueProduitPhoto {
  id                 String   @id @default(uuid())
  catalogueProduitId String   @map("catalogue_produit_id")
  url                String
  /// 0 = photo principale, celle qu'affichent les listes et le POS.
  /// Volontairement sans contrainte d'unicité : réordonner par échange
  /// passerait par un état transitoire à deux photos de même rang, qu'un
  /// index unique non différé refuserait.
  ordre              Int      @default(0)
  dateAjout          DateTime @default(now()) @map("date_ajout")

  catalogueProduit CatalogueProduit @relation(fields: [catalogueProduitId], references: [id], onDelete: Cascade)

  /// Sert la requête « photo principale de ce produit ».
  @@index([catalogueProduitId, ordre])
  @@map("catalogue_produit_photos")
}

/// Section 5.2 — ce qu'une officine ajoute par-dessus une fiche catalogue.
model PharmacyStock {
  id                 String @id @default(uuid())
  pharmacyId         String @map("pharmacy_id")
  catalogueProduitId String @map("catalogue_produit_id")

  /// Grossiste-répartiteur choisi par CETTE pharmacie pour CE produit.
  supplierId       String?  @map("supplier_id")
  stockMinimum     Int      @default(0) @map("stock_minimum")
  stockMaximum     Int?     @map("stock_maximum")
  dateAjout        DateTime @default(now()) @map("date_ajout")
  referenceInterne String?  @map("reference_interne")
  localisation     String?
  actifLocalement  Boolean  @default(true) @map("actif_localement")
  /// Parapharmacie uniquement : sans prix réglementé, le titulaire fixe son
  /// prix de vente librement.
  margeLibre       Decimal? @map("marge_libre") @db.Decimal(10, 2)
  /// Absent de la liste 5.2, mais imposé par la section 9 : le prix d'achat
  /// réellement facturé est propre à l'officine et doit être distingué du
  /// PPH/PPV réglementés du catalogue. Sans ce champ, `products.purchasePrice`
  /// serait perdu à la migration et le calcul de marge cesserait de
  /// fonctionner.
  prixAchat        Decimal? @map("prix_achat") @db.Decimal(10, 2)

  // ------------------------------------------------------------------
  // Copie complète et modifiable de la fiche catalogue (PRD 5.1).
  //
  // Correctif de conception : la phase 1 lisait ces champs à travers
  // `catalogueProduitId`. Ils sont désormais DUPLIQUÉS ici, et l'officine
  // les modifie sans jamais toucher au catalogue national — ni l'inverse.
  // Les deux lignes partent identiques après le backfill puis divergent
  // librement.
  //
  // Tout est nullable : la migration est additive sur une table déjà en
  // service, et un NULL se lit « pas encore recopié depuis le catalogue »,
  // ce qui rend le backfill rejouable sans écraser une saisie de la
  // pharmacie. `codeBarres` n'est surtout PAS unique ici, contrairement au
  // catalogue : deux officines stockent le même produit.
  // ------------------------------------------------------------------

  // --- Identification ---
  nom                   String?
  codeBarres            String?           @map("code_barres")
  dosage                String?
  categorie             ProduitCategorie?
  classeTherapeutique   String?           @map("classe_therapeutique")
  formeGalenique        String?           @map("forme_galenique")
  dci                   String?
  laboratoire           String?
  produitTableau        TableauSubstance? @map("produit_tableau")
  gamme                 String?
  sousGamme             String?           @map("sous_gamme")
  necessitePrescription Boolean?          @map("necessite_prescription")
  produitCommercialise  Boolean?          @map("produit_commercialise")
  groupeProduits        String?           @map("groupe_produits")
  /// Statut de la fiche telle que recopiée. Distinct de `actifLocalement`,
  /// qui dit si CETTE officine référence encore le produit.
  actifCatalogue        Boolean?          @map("actif_catalogue")
  refrigerationRequise  Boolean?          @map("refrigeration_requise")
  conditionnement       String?
  referenceLabo         String?           @map("reference_labo")

  // --- Prix et fiscalité ---
  pph                   Decimal? @db.Decimal(10, 2)
  ppv                   Decimal? @db.Decimal(10, 2)
  prixBaseRemboursement Decimal? @map("prix_base_remboursement") @db.Decimal(10, 2)
  tvaAchat              Decimal? @map("tva_achat") @db.Decimal(5, 2)
  tvaVente              Decimal? @map("tva_vente") @db.Decimal(5, 2)
  remboursable          Boolean?
  tauxRemboursement     Decimal? @map("taux_remboursement") @db.Decimal(5, 2)
  /// Les cinq champs de rayon et de marque, recopies du catalogue comme le
  /// reste. Ajoutes apres coup : la migration parapharmacie ne les avait
  /// posees que sur `catalogue_produits`, laissant la copie incomplete.
  marque                String?
  categoriePrincipale   String?  @map("categorie_principale")
  sousCategorie         String?  @map("sous_categorie")
  sousSousCategorie     String?  @map("sous_sous_categorie")
  etiquettes            String?
  /// Prix de reference non reglemente de la parapharmacie, recopie du
  /// catalogue au meme titre que le reste. Ajoute apres les 34 premieres
  /// colonnes : les lignes deja recopiees le recuperent par la passe de
  /// rattrapage du backfill, voir prisma/backfill-pharmacy-stock.ts.
  prixVenteIndicatif    Decimal? @map("prix_vente_indicatif") @db.Decimal(10, 2)

  // --- Descriptif ---
  description                 String?
  excipients                  String?
  posologieAdulte             String? @map("posologie_adulte")
  posologieEnfant             String? @map("posologie_enfant")
  indications                 String?
  contreIndicationConduite    String? @map("contre_indication_conduite")
  contreIndicationAllaitement String? @map("contre_indication_allaitement")
  contreIndicationGrossesse   String? @map("contre_indication_grossesse")
  monographie                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pharmacy  Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  /// Lien de traçabilité UNIQUEMENT : d'où vient cette fiche. Aucun code ne
  /// doit lire identification, prix ou descriptif à travers lui — ces
  /// valeurs vivent maintenant dans les colonnes ci-dessus.
  catalogue CatalogueProduit @relation(fields: [catalogueProduitId], references: [id])
  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lots      ProductLot[]

  /// Une officine ne référence un produit catalogue qu'une fois — les
  /// quantités multiples vivent dans les lots, pas dans des lignes en double.
  @@unique([pharmacyId, catalogueProduitId])
  @@index([pharmacyId])
  @@index([catalogueProduitId])
  @@map("pharmacy_stock")
}

/// Section 5.3 — une ligne par réception. La quantité totale d'un produit dans
/// une officine est la somme des lots actifs : le PRD précise qu'elle est
/// « dérivée, jamais saisie directement », d'où l'absence délibérée d'une
/// colonne quantité sur PharmacyStock.
model ProductLot {
  id              String @id @default(uuid())
  pharmacyStockId String @map("pharmacy_stock_id")

  /// Lu au Datamatrix à la réception. Nul pour les lignes issues de la
  /// migration : l'historique des lots réels n'existe pas avant celle-ci.
  numeroLot      String?   @map("numero_lot")
  quantite       Int       @default(0)
  /// Propre au lot — base du tri FEFO et des alertes 90/60/30 jours.
  datePeremption DateTime? @map("date_peremption")
  dateReception  DateTime  @default(now()) @map("date_reception")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pharmacyStock PharmacyStock @relation(fields: [pharmacyStockId], references: [id], onDelete: Cascade)

  @@index([pharmacyStockId])
  /// Le tri FEFO lit cet index.
  @@index([datePeremption])
  @@map("product_lots")
}

/// Journal d'audit, en ajout seul.
///
/// Créé ici pour la première fois : ce projet n'avait aucun mécanisme de
/// journalisation, sous ce nom ni sous un autre — un TODO le constatait
/// déjà dans lib/server/inventory.ts. Les modules suivants doivent
/// réutiliser cette table plutôt que d'en ouvrir une seconde.
model EventLog {
  id String @id @default(uuid())

  /// Qui a agi. Identifiant Supabase, volontairement SANS clé étrangère
  /// vers `users` : un administrateur Akribis n'a pas de ligne là-bas, il
  /// n'appartient à aucune pharmacie. Et l'e-mail est recopié plutôt que
  /// joint, pour que le journal reste lisible même si le compte disparaît.
  acteurId    String @map("acteur_id")
  acteurEmail String @map("acteur_email")
  acteurRole  String @map("acteur_role")

  /// L'action précise, en vocabulaire pointé : `catalogue.produit.cree`.
  typeAction String @map("type_action")

  /// Sur quoi elle a porté. Table et identifiant en texte, sans relation :
  /// un journal qui disparaîtrait avec ce qu'il décrit ne servirait à rien.
  entite   String
  entiteId String @map("entite_id")

  /// Portée. Nulle pour une action nationale — l'Admin catalogue n'agit
  /// pour aucune officine en particulier.
  pharmacyId String? @map("pharmacy_id")

  /// L'état avant et après, quand la notion a un sens. `avant` est nul à
  /// la création, `apres` le serait à une suppression.
  avant Json?
  apres Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([typeAction, createdAt])
  @@index([entite, entiteId])
  @@index([acteurId, createdAt])
  @@map("event_log")
}

/// Un organisme de tiers payant : CNSS/AMO, CNOPS, une mutuelle ou une
/// assurance privée.
///
/// Propre à chaque officine — deux pharmacies peuvent conventionner avec
/// des organismes différents, et négocier des taux différents avec le même.
/// D'où `pharmacy_id` sur chaque ligne, et l'unicité du code qui vaut par
/// officine et non globalement.
model OrganismeTiersPayant {
  id         String @id @default(uuid())
  pharmacyId String @map("pharmacy_id")

  nom  String
  /// Le code par lequel l'organisme s'identifie sur les bordereaux.
  code String

  /// Part prise en charge par défaut, en pourcentage. Un point de départ :
  /// le taux réel se décide vente par vente, un même organisme ne couvrant
  /// pas un générique comme un princeps.
  tauxCouverture Decimal @default(0) @map("taux_couverture") @db.Decimal(5, 2)

  /// Format de bordereau attendu, en texte libre pour l'instant. À
  /// structurer le jour où l'on générera les bordereaux pour de bon —
  /// aujourd'hui c'est une note que l'officine se laisse à elle-même.
  formatBordereau String? @map("format_bordereau")

  /// Désactivé, jamais supprimé : des ventes passées le référencent, et
  /// les faire disparaître fausserait la traçabilité qu'elles servent.
  actif Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, code])
  @@index([pharmacyId, actif])
  @@map("organismes_tiers_payant")
}
